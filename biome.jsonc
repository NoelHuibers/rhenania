{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!**/*.svg", "!drizzle/**/meta"],
		"maxSize": 2097152
	},
	"formatter": { "enabled": true },
	"css": {
		"parser": {
			"cssModules": false,
			"allowWrongLineComments": true,
			"tailwindDirectives": true
		},
		"linter": {
			"enabled": false
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {
						"functions": ["clsx", "cva", "cn"]
					}
				}
			},
			"a11y": {
				// Swapping role-based divs for semantic elements changes the DOM;
				// re-enable together with a visual review (see #103 follow-up).
				"useSemanticElements": "off"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noImplicitAnyLet": "error",
				"noEvolvingTypes": "error",
				"noEmptyBlockStatements": "error",
				"noConsole": {
					"level": "error",
					"options": { "allow": ["error", "warn"] }
				}
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noUnusedFunctionParameters": "error",
				"useExhaustiveDependencies": "error",
				"useHookAtTopLevel": "error"
			},
			"style": {
				"noNonNullAssertion": "error",
				"noParameterAssign": "error",
				"useBlockStatements": "error",
				"useConst": "error",
				"useImportType": "error",
				"useExportType": "error",
				"noDefaultExport": "error",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"@radix-ui/react-label": "Import from the \"radix-ui\" package instead.",
							"@radix-ui/react-slot": "Import from the \"radix-ui\" package instead."
						}
					}
				}
			},
			"complexity": {
				"noForEach": "error",
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": { "maxAllowedComplexity": 25 }
				}
			}
		}
	},
	"overrides": [
		{
			// Next.js route files, the proxy, configs and tool entry points must
			// default-export.
			"includes": [
				"src/app/**",
				"src/proxy.ts",
				"*.config.ts",
				"*.config.mjs",
				"*.config.js",
				"drizzle.*.ts",
				"test/global-setup.ts"
			],
			"linter": { "rules": { "style": { "noDefaultExport": "off" } } }
		},
		{
			// CLI scripts and test tooling talk to the console on purpose.
			"includes": ["scripts/**", "e2e/**", "test/**", "src/server/db/seed.ts"],
			"linter": {
				"rules": { "suspicious": { "noConsole": { "level": "off" } } }
			}
		},
		{
			// No-op mocks (`mockImplementation(() => {})`) are idiomatic in tests.
			"includes": ["**/*.test.ts", "test/**", "e2e/**"],
			"linter": {
				"rules": {
					"suspicious": { "noEmptyBlockStatements": { "level": "off" } }
				}
			}
		},
		{
			// Pages, route handlers and UI never reach for a database client
			// (#33): page data comes from a loader in src/server/loaders, a
			// server action or src/server/lib. The schema modules are allowed:
			// no connection sits behind them, and Biome can't limit an import
			// to `import type`.
			"includes": ["src/app/**", "src/components/**", "src/hooks/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"~/server/db",
											"~/server/db/*",
											"**/server/db",
											"**/server/db/*",
											"!~/server/db/schema",
											"!~/server/db/control-schema",
											"!**/server/db/schema",
											"!**/server/db/control-schema"
										],
										"message": "No DB access in src/app or src/components: load the data in src/server/loaders, a server action or src/server/lib."
									}
								],
								"paths": {
									"@radix-ui/react-label": "Import from the \"radix-ui\" package instead.",
									"@radix-ui/react-slot": "Import from the \"radix-ui\" package instead."
								}
							}
						}
					}
				}
			}
		}
	]
}
