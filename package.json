{
	"name": "rhenania",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "[ -n \"$CI\" ] || lefthook install",
		"build": "next build",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"format": "biome format .",
		"format:write": "biome format --write .",
		"lint": "biome lint . && tsc --noEmit",
		"lint:write": "biome lint --write .",
		"knip": "SKIP_ENV_VALIDATION=1 knip && SKIP_ENV_VALIDATION=1 knip --production",
		"db:generate": "drizzle-kit generate",
		"db:check": "tsx scripts/ci/check-migrations.ts && drizzle-kit check && drizzle-kit check --config=drizzle.control.config.ts",
		"db:migrate": "tsx scripts/ops/migrate-tenants.ts",
		"db:migrate-tenants": "tsx scripts/ops/migrate-tenants.ts",
		"db:seed": "tsx src/server/db/seed.ts",
		"db:studio": "drizzle-kit studio",
		"db:control:generate": "drizzle-kit generate --config=drizzle.control.config.ts",
		"db:control:migrate": "drizzle-kit migrate --config=drizzle.control.config.ts",
		"db:control:seed": "tsx scripts/ops/seed-control.ts",
		"grant-superadmin": "tsx scripts/ops/grant-superadmin.ts",
		"grant-tenant-admin": "tsx scripts/ops/grant-tenant-admin.ts",
		"db:backfill-tenant-config": "tsx scripts/ops/backfill-tenant-config.ts",
		"db:backfill-billing-profile": "tsx scripts/ops/backfill-billing-profile.ts",
		"db:control:studio": "drizzle-kit studio --config=drizzle.control.config.ts",
		"dev": "next dev --turbo",
		"dev:local": "tsx scripts/dev/run.ts next dev --turbo",
		"db:local:reset": "tsx scripts/dev/setup-local.ts",
		"diag:tenant-health": "tsx scripts/diag/tenant-health.ts",
		"diag:memberships": "tsx scripts/diag/check-memberships.ts",
		"diag:diff-tables": "tsx scripts/diag/diff-tenant-tables.ts",
		"diag:control-journal": "tsx scripts/diag/inspect-control-journal.ts",
		"diag:migration-journal": "tsx scripts/diag/inspect-migration-journal.ts",
		"diag:member-statuses": "tsx scripts/diag/list-member-statuses.ts",
		"diag:duplicate-settlements": "tsx scripts/diag/duplicate-settlements.ts",
		"ops:reconcile-user-mirror": "tsx scripts/ops/reconcile-user-mirror.ts",
		"ops:repair-fuchsen-carry": "tsx scripts/ops/repair-fuchsen-carry.ts",
		"preview": "next build && next start",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:mutation": "stryker run",
		"proxy-db:check": "tsx scripts/ci/proxy-db-ratchet.ts",
		"proxy-db:baseline": "tsx scripts/ci/proxy-db-ratchet.ts --update",
		"coverage:check": "tsx scripts/ci/coverage-ratchet.ts",
		"coverage:baseline": "tsx scripts/ci/coverage-ratchet.ts --update",
		"test:e2e": "playwright test --project=desktop --project=mobile",
		"test:e2e:dev": "E2E_DEV=1 playwright test",
		"test:visual": "bash scripts/dev/visual.sh",
		"test:visual:update": "bash scripts/dev/visual.sh --update-snapshots"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.4.0",
		"@libsql/client": "^0.17.3",
		"@microsoft/microsoft-graph-client": "^3.0.7",
		"@react-pdf/renderer": "^4.5.1",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tanstack/react-table": "^8.21.3",
		"@vercel/analytics": "^2.0.1",
		"@vercel/blob": "^2.4.0",
		"@vercel/speed-insights": "^2.0.0",
		"bcryptjs": "^3.0.3",
		"better-auth": "~1.7.14",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"exceljs": "^4.4.0",
		"fflate": "^0.8.3",
		"gsap": "^3.15.0",
		"jspdf": "^4.2.1",
		"lucide-react": "^1.18.0",
		"next": "^16.4.3",
		"next-themes": "^0.4.6",
		"nodemailer": "^10.2.1",
		"qrcode": "^1.5.4",
		"qrcode.react": "^4.2.0",
		"radix-ui": "^1.5.0",
		"react": "^19.2.7",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.7",
		"react-hook-form": "^7.79.0",
		"react-icons": "^5.6.0",
		"recharts": "3.8.1",
		"server-only": "^0.0.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"vaul": "^1.1.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "2.5.0",
		"@playwright/test": "^1.64.1",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@tailwindcss/postcss": "^4.3.1",
		"@types/node": "^25.9.3",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "^5.0.5",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"knip": "^6.43.0",
		"lefthook": "^2.2.2",
		"postcss": "^8.5.31",
		"shadcn": "^4.22.1",
		"tailwindcss": "^4.3.1",
		"tsx": "^4.22.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": ">=24.0.0"
	},
	"pnpm": {
		"overrides": {
			"undici@<6.29.1": "^6.29.1",
			"dompurify@<3.4.17": "^3.4.17",
			"postcss@<8.5.23": "^8.5.31",
			"nanoid@>=3.0.0 <3.3.18": "^3.3.18",
			"qs@<6.16.0": "^6.16.0",
			"esbuild@<0.25.0": "^0.25.0",
			"uuid@<11.1.1": "^11.1.1",
			"shell-quote@<1.11.0": "^1.11.0",
			"brace-expansion@<1.1.21": "^1.1.21",
			"brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
			"fflate@<0.8.3": "^0.8.3",
			"source-map-js@<1.2.2": "^1.2.2",
			"baseline-browser-mapping@<2.11.0": "^2.11.0"
		}
	}
}
